+// Copyright (c) rAthena Dev Teams - Licensed under GNU GPL
+#include "stylist.hpp"
+
+#include <cstring>
+#include <random>
+#include <unordered_map>
+
+#include <common/showmsg.hpp>
+#include <common/socket.hpp>
+#include <common/timer.hpp>
+#include <common/utilities.hpp>
+#include "battle.hpp"
+#include "chrif.hpp"
+#include "clif.hpp"

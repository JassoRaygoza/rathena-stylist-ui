diff --git a/conf/battle/stylist.conf b/conf/battle/stylist.conf
new file mode 100644
index 0000000000000000000000000000000000000000..c7cd00a31bf10f446c424a5a49e82197dca82ad4
--- /dev/null
+++ b/conf/battle/stylist.conf
@@ -0,0 +1,25 @@
+// Modern Stylist UI. Loaded by conf/battle_athena.conf.
+// Deploy matching map/char builds, the SQL migration and client catalogue together.
+feature.stylist: on
+
+// Minimum group level. 0 enables all players; 99 restricts a test rollout.
+stylist_min_group: 0
+// Every eligible class may wear outfits from its own evolution branch.
+// Install client/data (expanded catalogue). Standard variant requires off.
+stylist_class_lineage: on
+// Add tier bits: 1 = all eligible jobs, 2 = second, 4 = transcendent,
+// 8 = third, 16 = fourth. Novice and Baby jobs cannot change outfits.
+stylist_costume_jobs: 30
+// Requires sql-files/upgrades/stylist_accessories.sql and InnoDB tables.
+stylist_accessory_mail: on
+stylist_packet_debug: off
+
+// Limits matched to the included human catalogue. Color 0 is the default.
+// The client must already contain the corresponding PAL, SPR and ACT resources.
+min_hair_style: 0
+max_hair_style: 42
+min_hair_color: 0
+max_hair_color: 5
+min_cloth_color: 0
+max_cloth_color: 667
+pet_hair_style: 100
